{
  "name": "@scorel/app-gui",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "main": "./.dist/main.cjs",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:runtime": "node ./scripts/build-runtime.mjs",
    "dist:mac": "pnpm --dir ../.. build:package && pnpm build && pnpm build:runtime && pnpm dlx electron-builder@26.15.3 --mac --publish never",
    "dev": "pnpm build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "dev.chanler.scorel",
    "productName": "Scorel",
    "directories": {
      "output": "release"
    },
    "files": [
      ".dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".runtime",
        "to": "."
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ChanlerDev",
        "repo": "Scorel"
      }
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@scorel/client": "workspace:*",
    "@scorel/daemon": "workspace:*",
    "@scorel/protocol": "workspace:*",
    "@shikijs/rehype": "^4.1.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.488.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@scorel/core": "workspace:*",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "electron": "^42.3.3",
    "vitest": "4.0.13"
  }
}
