# Copy this file to eval/.env, replace every placeholder, and keep eval/.env private.
SCOREL_EVAL_PROVIDER=replace-with-provider-label
SCOREL_EVAL_API=openai-completions
SCOREL_EVAL_BASE_URL=https://api.example.test/v1
SCOREL_EVAL_API_KEY=replace-with-api-key
SCOREL_EVAL_MODEL=replace-with-model-id
SCOREL_EVAL_REASONING_EFFORT=max

# Public-safe Terminal-Bench defaults. Override any value locally as needed.
SCOREL_EVAL_DATASET=terminal-bench/terminal-bench-2-1
SCOREL_EVAL_ENVIRONMENT=daytona
SCOREL_EVAL_ATTEMPTS=2
SCOREL_EVAL_CONCURRENCY=3
# Harbor multiplies each task's configured timeout by these values.
SCOREL_EVAL_TIMEOUT_MULTIPLIER=4
SCOREL_EVAL_AGENT_TIMEOUT_MULTIPLIER=4
# Agent setup base: 6 minutes; 2x allows up to 12 minutes.
SCOREL_EVAL_AGENT_SETUP_TIMEOUT_MULTIPLIER=2
# Environment startup base: 10 minutes; 3x allows up to 30 minutes.
SCOREL_EVAL_ENVIRONMENT_BUILD_TIMEOUT_MULTIPLIER=3
SCOREL_EVAL_MAX_RETRIES=2

# Required by Harbor when SCOREL_EVAL_ENVIRONMENT=daytona. Alternatively set
# both DAYTONA_JWT_TOKEN and DAYTONA_ORGANIZATION_ID in the private eval/.env.
DAYTONA_API_KEY=replace-with-daytona-api-key

# Set to true only when the scrubbed job should be uploaded privately to Harbor.
SCOREL_EVAL_UPLOAD_PRIVATE=false
